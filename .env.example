NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/oneblue_chat
MONGODB_DATABASE=oneblue_chat
MONGODB_COLLECTION=conversations
AWS_REGION=us-east-1
AWS_ENDPOINT=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:topic-oneblue-chat-interactions
SQS_QUEUE_URL=http://127.0.0.1:4566/000000000000/queue-oneblue-chat-interactions-mover
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
# Same formats supported by BFA: raw JSON, base64 JSON, or file:// path.
GCP_SA_INTGR_BFA=
BIGQUERY_DATASET=chat_analytics
BIGQUERY_TABLE=evs_chat_conversations
BFA_PORT=3001
BFF_PORT=3000
GCP_REGION=us-central1
