config {
  type: "table",
  schema: "chat_analytics",
  description: "Mart diario deduplicado de interacciones del chatbot. Contiene PII.",
  tags: ["chatbot", "daily"],
  bigquery: {
    partitionBy: "interactionDate",
    clusterBy: ["motivo"]
  }
}

WITH ranked AS (
  SELECT
    DATE(datetimeMetadata) AS interactionDate,
    conversationId,
    userEmail,
    motivo,
    razonamiento,
    calidadAtencion,
    resolucion,
    comentario,
    agenteId,
    messagesCount,
    durationSeconds,
    status,
    closedAt,
    occurredAt,
    ingestedAt,
    datetimeMetadata,
    ROW_NUMBER() OVER (
      PARTITION BY conversationId
      ORDER BY closedAt DESC, occurredAt DESC, ingestedAt DESC
    ) AS duplicateRank
  FROM ${ref("evs_chat_conversations")}
),
deduplicated AS (
  SELECT *
  FROM ranked
  WHERE duplicateRank = 1
)
SELECT
  interactionDate,
  motivo,
  COUNT(*) AS totalConversations,
  COUNTIF(status = 'COMPLETED') AS completedConversations,
  COUNTIF(status = 'OPEN') AS openConversations,
  COUNTIF(status = 'ABANDONED') AS abandonedConversations,
  SAFE_DIVIDE(COUNTIF(status = 'COMPLETED'), COUNT(*)) AS completionRate,
  COUNTIF(calidadAtencion IS NOT NULL OR resolucion IS NOT NULL)
    AS surveySubmittedConversations,
  SAFE_DIVIDE(
    COUNTIF(
      status = 'COMPLETED'
      AND (calidadAtencion IS NOT NULL OR resolucion IS NOT NULL)
    ),
    COUNTIF(status = 'COMPLETED')
  ) AS surveyComplianceRate,
  COUNTIF(calidadAtencion IS NOT NULL OR resolucion IS NOT NULL)
    AS ratedConversations,
  COUNTIF(comentario IS NOT NULL) AS withComments,
  COUNTIF(
    (calidadAtencion IS NOT NULL OR resolucion IS NOT NULL)
    AND comentario IS NULL
  ) AS withoutComments,
  AVG(calidadAtencion) AS averageQuality,
  AVG(resolucion) AS averageResolution,
  COUNTIF(resolucion >= 5) / NULLIF(COUNT(resolucion), 0)
    AS satisfactoryResolutionRate,
  COUNTIF(calidadAtencion <= 3 OR resolucion <= 3) AS criticalCases,
  AVG(durationSeconds) AS averageDurationSeconds,
  ARRAY_AGG(DISTINCT userEmail IGNORE NULLS) AS participantEmails,
  ARRAY_AGG(
    STRUCT(
      userEmail,
      status,
      comentario,
      calidadAtencion,
      resolucion,
      closedAt
    )
    IGNORE NULLS
  ) AS participantCases
FROM deduplicated
GROUP BY interactionDate, motivo
